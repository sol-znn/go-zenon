diff --git a/lib/src/crypto/secp256k1.dart b/lib/src/crypto/secp256k1.dart
new file mode 100644
index 0000000..a42baaa
--- /dev/null
+++ b/lib/src/crypto/secp256k1.dart
@@ -0,0 +1,111 @@
+import 'dart:typed_data';
+
+import 'package:pointycastle/ecc/api.dart';
+import 'package:pointycastle/ecc/curves/secp256k1.dart';
+
+/// secp256k1 scalar and point arithmetic for the PTLC point types.
+///
+/// Built on pointycastle's curve parameters, which the SDK already depends on,
+/// because no pub package implements BIP-340 or scalar-to-point helpers and a
+/// second big-number library would be a second thing to audit. Everything here
+/// is plain group arithmetic; the signature scheme is in `bip340.dart`.
+class Secp256k1 {
+  static final ECDomainParameters params = ECCurve_secp256k1();
+
+  /// The group order n.
+  static final BigInt n = params.n;
+
+  /// The field prime p = 2^256 - 2^32 - 977. pointycastle's generic curve
+  /// interface does not expose it, and secp256k1's is fixed.
+  static final BigInt p = BigInt.parse(
+      'FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFEFFFFFC2F',
+      radix: 16);
+
+  /// The generator G.
+  static ECPoint get g => params.G;
+
+  /// A 32-byte big-endian encoding of a scalar.
+  static Uint8List scalarToBytes(BigInt s) => bigIntToBytes(s, 32);
+
+  /// The scalar encoded by 32 big-endian bytes, or null when the bytes are not
+  /// a canonical scalar: not 32 bytes, zero, or at or above n. One secret has
+  /// exactly one encoding, which is what the contract requires of a witness.
+  static BigInt? parseScalar(List<int> bytes) {
+    if (bytes.length != 32) return null;
+    final s = bytesToBigInt(bytes);
+    if (s == BigInt.zero || s >= n) return null;
+    return s;
+  }
+
+  /// t·G as a 33-byte compressed point: the lock a scalar witness opens.
+  static Uint8List scalarToPoint(BigInt t) =>
+      Uint8List.fromList((g * (t % n))!.getEncoded(true));
+
+  /// The point encoded by 33 compressed bytes, or null when the bytes do not
+  /// encode a point on the curve with an 0x02 or 0x03 prefix.
+  static ECPoint? parseCompressed(List<int> bytes) {
+    if (bytes.length != 33 || (bytes[0] != 0x02 && bytes[0] != 0x03)) {
+      return null;
+    }
+    try {
+      final point = params.curve.decodePoint(bytes);
+      if (point == null || point.isInfinity) return null;
+      return point;
+    } catch (_) {
+      return null;
+    }
+  }
+
+  /// The even-y point with the given x coordinate (BIP-340 lift_x), or null.
+  static ECPoint? liftX(List<int> xOnly) {
+    if (xOnly.length != 32) return null;
+    if (bytesToBigInt(xOnly) >= p) return null;
+    return parseCompressed([0x02, ...xOnly]);
+  }
+
+  /// The 32-byte x coordinate of a point.
+  static Uint8List xOnly(ECPoint point) =>
+      bigIntToBytes(point.x!.toBigInteger()!, 32);
+
+  /// Whether a point's y coordinate is even, which is the parity BIP-340 fixes
+  /// for public keys and nonces.
+  static bool hasEvenY(ECPoint point) =>
+      point.y!.toBigInteger()!.isEven;
+
+  /// Encodes a point as 33 compressed bytes.
+  static Uint8List compress(ECPoint point) =>
+      Uint8List.fromList(point.getEncoded(true));
+
+  /// Adds a scalar tweak to a point: T + d·G. This is what makes two legs of a
+  /// swap show different points while one secret opens both.
+  static Uint8List tweakPoint(List<int> compressed, BigInt d) {
+    final t = parseCompressed(compressed);
+    if (t == null) throw ArgumentError('not a compressed secp256k1 point');
+    final sum = (t + (g * (d % n)))!;
+    if (sum.isInfinity) throw ArgumentError('tweak cancels the point');
+    return compress(sum);
+  }
+
+  /// Adds a scalar tweak to a scalar: (t + d) mod n.
+  static BigInt tweakScalar(BigInt t, BigInt d) => (t + d) % n;
+
+  static Uint8List bigIntToBytes(BigInt value, int length) {
+    if (value.isNegative) throw ArgumentError('negative');
+    final out = Uint8List(length);
+    var v = value;
+    for (var i = length - 1; i >= 0; i--) {
+      out[i] = (v & BigInt.from(0xff)).toInt();
+      v = v >> 8;
+    }
+    if (v != BigInt.zero) throw ArgumentError('value does not fit');
+    return out;
+  }
+
+  static BigInt bytesToBigInt(List<int> bytes) {
+    var v = BigInt.zero;
+    for (final b in bytes) {
+      v = (v << 8) | BigInt.from(b & 0xff);
+    }
+    return v;
+  }
+}
