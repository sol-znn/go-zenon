+import 'package:znn_sdk_dart/src/model/primitives.dart';
+import 'package:znn_sdk_dart/src/utils/utils.dart';
+
+/// The point types of the ptlc contract. The two key types are opened by a
+/// signature over the unlock message; the point type is opened by the scalar
+/// behind the point, and its entry names the one address an unlock may pay.
+class PtlcPointType {
+  static const int ed25519 = 0;
+  static const int bip340 = 1;
+  static const int secp256k1Point = 2;
+
+  static const Map<int, int> lockSizes = {
+    ed25519: 32,
+    bip340: 32,
+    secp256k1Point: 33
+  };
+  static const Map<int, int> witnessSizes = {
+    ed25519: 64,
+    bip340: 64,
+    secp256k1Point: 32
+  };
+
+  static String name(int pointType) {
+    switch (pointType) {
+      case ed25519:
+        return 'ED25519 key';
+      case bip340:
+        return 'BIP-340 key';
+      case secp256k1Point:
+        return 'secp256k1 point';
+      default:
+        return 'unknown ($pointType)';
+    }
+  }
+}
+
+class PtlcInfo {
+  Hash id;
+  Address timeLocked;
+  TokenStandard tokenStandard;
+  BigInt amount;
+  int expirationTime;
+  int pointType;
+  List<int> pointLock;
+  Address destination;
+
+  PtlcInfo(
+      {required this.id,
+      required this.timeLocked,
+      required this.tokenStandard,
+      required this.amount,
+      required this.expirationTime,
+      required this.pointType,
+      required this.pointLock,
+      required this.destination});
+
+  PtlcInfo.fromJson(Map<String, dynamic> json)
+      : id = Hash.parse(json['id']),
+        timeLocked = Address.parse(json['timeLocked']),
+        tokenStandard = TokenStandard.parse(json['tokenStandard']),
+        amount = BigInt.parse(json['amount'].toString()),
+        expirationTime = json['expirationTime'],
+        pointType = json['pointType'],
+        pointLock = BytesUtils.base64ToBytes(json['pointLock']) ?? [],
+        destination = Address.parse(json['destination']);
+
+  /// Whether the entry pays only one address.
+  bool get hasFixedDestination => destination != emptyAddress;
+
+  Map<String, dynamic> toJson() => {
+        'id': id.toString(),
+        'timeLocked': timeLocked.toString(),
+        'tokenStandard': tokenStandard.toString(),
+        'amount': amount.toString(),
+        'expirationTime': expirationTime,
+        'pointType': pointType,
+        'pointLock': BytesUtils.bytesToBase64(pointLock),
+        'destination': destination.toString(),
+      };
+}
