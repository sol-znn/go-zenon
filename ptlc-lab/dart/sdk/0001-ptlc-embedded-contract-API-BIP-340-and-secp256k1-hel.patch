diff --git a/lib/src/api/embedded/ptlc.dart b/lib/src/api/embedded/ptlc.dart
new file mode 100644
index 0000000..f1ec693
--- /dev/null
+++ b/lib/src/api/embedded/ptlc.dart
@@ -0,0 +1,82 @@
+import 'dart:typed_data';
+
+import 'package:znn_sdk_dart/src/client/client.dart';
+import 'package:znn_sdk_dart/src/crypto/crypto.dart';
+import 'package:znn_sdk_dart/src/embedded/embedded.dart';
+import 'package:znn_sdk_dart/src/model/model.dart';
+import 'package:znn_sdk_dart/src/model/primitives.dart';
+
+class PtlcApi {
+  late Client client;
+
+  void setClient(Client client) {
+    this.client = client;
+  }
+
+  // RPC
+  Future<PtlcInfo> getById(Hash id) async {
+    var response =
+        await client.sendRequest('embedded.ptlc.getById', [id.toString()]);
+    return PtlcInfo.fromJson(response!);
+  }
+
+  // Contract methods
+
+  /// Locks [amount] of [token] to [pointLock] until [expirationTime]. A point
+  /// of type [PtlcPointType.secp256k1Point] must name a [destination]; a key
+  /// type may pass [emptyAddress] to let the signature choose it.
+  AccountBlockTemplate create(Token token, BigInt amount, int expirationTime,
+      int pointType, List<int> pointLock, Address destination) {
+    return AccountBlockTemplate.callContract(
+        ptlcAddress,
+        token.tokenStandard,
+        amount,
+        Definitions.ptlc.encodeFunction(
+            'Create', [expirationTime, pointType, pointLock, destination]));
+  }
+
+  AccountBlockTemplate reclaim(Hash id) {
+    return AccountBlockTemplate.callContract(ptlcAddress, znnZts, BigInt.zero,
+        Definitions.ptlc.encodeFunction('Reclaim', [id.getBytes()]));
+  }
+
+  /// Unlocks to the caller. [witness] is a signature over the unlock message
+  /// for a key type, or the scalar for a point type.
+  AccountBlockTemplate unlock(Hash id, List<int> witness) {
+    return AccountBlockTemplate.callContract(ptlcAddress, znnZts, BigInt.zero,
+        Definitions.ptlc.encodeFunction('Unlock', [id.getBytes(), witness]));
+  }
+
+  /// Unlocks to [destination] on anyone's behalf. For a key type the witness
+  /// must have been signed over this destination.
+  AccountBlockTemplate proxyUnlock(
+      Hash id, Address destination, List<int> witness) {
+    return AccountBlockTemplate.callContract(
+        ptlcAddress,
+        znnZts,
+        BigInt.zero,
+        Definitions.ptlc.encodeFunction(
+            'ProxyUnlock', [id.getBytes(), destination, witness]));
+  }
+
+  // Unlock message
+
+  /// The message a key-type witness signs: SHA3-256 over the domain string
+  /// `zenon-ptlc-unlock:v1`, the chain identifier (8 bytes, big-endian), the
+  /// contract address (20 bytes), the point type (1 byte), the id (32 bytes)
+  /// and the destination (20 bytes). The chain identifier is the frontier
+  /// momentum's.
+  static List<int> unlockMessage(
+      int chainIdentifier, int pointType, Hash id, Address destination) {
+    final chain = Uint8List(8);
+    ByteData.view(chain.buffer).setUint64(0, chainIdentifier, Endian.big);
+    return Crypto.digest([
+      ...'zenon-ptlc-unlock:v1'.codeUnits,
+      ...chain,
+      ...ptlcAddress.getBytes()!,
+      pointType,
+      ...id.getBytes()!,
+      ...destination.getBytes()!,
+    ]);
+  }
+}
diff --git a/lib/src/crypto/bip340.dart b/lib/src/crypto/bip340.dart
new file mode 100644
index 0000000..0b631b5
--- /dev/null
+++ b/lib/src/crypto/bip340.dart
@@ -0,0 +1,190 @@
+import 'dart:typed_data';
+
+import 'package:pointycastle/digests/sha256.dart';
+import 'package:znn_sdk_dart/src/crypto/secp256k1.dart';
+
+/// BIP-340 Schnorr signatures over secp256k1, and the single-signer adaptor
+/// construction on top of them.
+///
+/// The signing algorithm is the BIP's reference algorithm, step for step, so
+/// that the official test vectors pass unchanged. The adaptor construction is
+/// the one in Blockstream's scriptless-scripts atomic swap note and
+/// libsecp256k1-zkp's `schnorr_adaptor` module: the pre-signature nonce is
+/// `R = k·G + T`, the pre-signature scalar is `s' = k + e·d`, and the completed
+/// signature is `s = s' + t` when R has even y, `s' - t` otherwise. Whoever
+/// holds the pre-signature and sees the completed signature learns `t`.
+class Bip340 {
+  static const String _auxTag = 'BIP0340/aux';
+  static const String _nonceTag = 'BIP0340/nonce';
+  static const String _challengeTag = 'BIP0340/challenge';
+
+  static Uint8List sha256(List<int> data) =>
+      SHA256Digest().process(Uint8List.fromList(data));
+
+  /// SHA256(SHA256(tag) ‖ SHA256(tag) ‖ msg).
+  static Uint8List taggedHash(String tag, List<int> msg) {
+    final tagHash = sha256(Uint8List.fromList(tag.codeUnits));
+    return sha256([...tagHash, ...tagHash, ...msg]);
+  }
+
+  /// The x-only public key of a 32-byte secret key.
+  static Uint8List publicKey(List<int> secretKey) {
+    final d = _secret(secretKey);
+    return Secp256k1.xOnly((Secp256k1.g * d)!);
+  }
+
+  /// Signs a message of any length (BIP-340 since its 2023 revision). `auxRand`
+  /// must be 32 bytes and should be fresh
+  /// per signature; the BIP's vectors use fixed values, which is why it is a
+  /// parameter.
+  static Uint8List sign(
+      List<int> secretKey, List<int> message, List<int> auxRand) {
+    _check32(auxRand, 'auxRand');
+    final d0 = _secret(secretKey);
+    final pPoint = (Secp256k1.g * d0)!;
+    final d = Secp256k1.hasEvenY(pPoint) ? d0 : Secp256k1.n - d0;
+    final pBytes = Secp256k1.xOnly(pPoint);
+
+    final k = _nonce(d, pBytes, message, auxRand);
+    final rPoint = (Secp256k1.g * k)!;
+    final kFinal = Secp256k1.hasEvenY(rPoint) ? k : Secp256k1.n - k;
+    final rBytes = Secp256k1.xOnly(rPoint);
+
+    final e = _challenge(rBytes, pBytes, message);
+    final s = (kFinal + e * d) % Secp256k1.n;
+    final signature = Uint8List.fromList([...rBytes, ...Secp256k1.scalarToBytes(s)]);
+    if (!verify(pBytes, message, signature)) {
+      throw StateError('the signature does not verify');
+    }
+    return signature;
+  }
+
+  /// Verifies a 64-byte signature by an x-only public key over a message of
+  /// any length. Any malformed input is simply an invalid signature.
+  static bool verify(List<int> publicKey, List<int> message, List<int> signature) {
+    if (publicKey.length != 32 || signature.length != 64) {
+      return false;
+    }
+    final pPoint = Secp256k1.liftX(publicKey);
+    if (pPoint == null) return false;
+    final r = Secp256k1.bytesToBigInt(signature.sublist(0, 32));
+    if (r >= Secp256k1.p) return false;
+    final s = Secp256k1.bytesToBigInt(signature.sublist(32));
+    if (s >= Secp256k1.n) return false;
+    final e = _challenge(signature.sublist(0, 32), publicKey, message);
+    final rPoint = ((Secp256k1.g * s)! + (pPoint * (Secp256k1.n - e))!)!;
+    if (rPoint.isInfinity) return false;
+    if (!Secp256k1.hasEvenY(rPoint)) return false;
+    return rPoint.x!.toBigInteger()! == r;
+  }
+
+  /// Produces an adaptor pre-signature on the point `adaptor` (33 compressed
+  /// bytes): 33 bytes of R (compressed, so that its parity travels with it)
+  /// followed by 32 bytes of s'. The pre-signature is useless as a signature
+  /// and reveals nothing about the secret behind `adaptor`.
+  static Uint8List adaptorSign(List<int> secretKey, List<int> message,
+      List<int> adaptor, List<int> auxRand) {
+    _check32(auxRand, 'auxRand');
+    final tPoint = Secp256k1.parseCompressed(adaptor);
+    if (tPoint == null) throw ArgumentError('adaptor is not a compressed point');
+    final d0 = _secret(secretKey);
+    final pPoint = (Secp256k1.g * d0)!;
+    final d = Secp256k1.hasEvenY(pPoint) ? d0 : Secp256k1.n - d0;
+    final pBytes = Secp256k1.xOnly(pPoint);
+
+    // The adaptor point is mixed into the auxiliary randomness so that the
+    // same key, message and aux never produce the same k for two adaptors.
+    final aux = taggedHash('zenon/ptlc/adaptor-aux', [...auxRand, ...adaptor]);
+    final k0 = _nonce(d, pBytes, message, aux);
+    final rPrime = (Secp256k1.g * k0)!;
+    final rPoint = (rPrime + tPoint)!;
+    if (rPoint.isInfinity) throw StateError('nonce cancels the adaptor');
+    final k = Secp256k1.hasEvenY(rPoint) ? k0 : Secp256k1.n - k0;
+    final e = _challenge(Secp256k1.xOnly(rPoint), pBytes, message);
+    final sPrime = (k + e * d) % Secp256k1.n;
+    final presig = Uint8List.fromList(
+        [...Secp256k1.compress(rPoint), ...Secp256k1.scalarToBytes(sPrime)]);
+    if (!adaptorVerify(pBytes, message, adaptor, presig)) {
+      throw StateError('the pre-signature does not verify');
+    }
+    return presig;
+  }
+
+  /// Checks that a pre-signature was made by `publicKey` over `message` on the
+  /// adaptor point: s'·G must equal (R - T) + e·P when R has even y, and
+  /// (T - R) + e·P otherwise.
+  static bool adaptorVerify(List<int> publicKey, List<int> message,
+      List<int> adaptor, List<int> presig) {
+    if (publicKey.length != 32 || presig.length != 65) {
+      return false;
+    }
+    final pPoint = Secp256k1.liftX(publicKey);
+    final tPoint = Secp256k1.parseCompressed(adaptor);
+    final rPoint = Secp256k1.parseCompressed(presig.sublist(0, 33));
+    if (pPoint == null || tPoint == null || rPoint == null) return false;
+    final sPrime = Secp256k1.bytesToBigInt(presig.sublist(33));
+    if (sPrime >= Secp256k1.n) return false;
+    final e = _challenge(Secp256k1.xOnly(rPoint), publicKey, message);
+    final ePoint = (pPoint * e)!;
+    final expected = Secp256k1.hasEvenY(rPoint)
+        ? ((rPoint - tPoint)! + ePoint)!
+        : ((tPoint - rPoint)! + ePoint)!;
+    final actual = (Secp256k1.g * sPrime)!;
+    return !expected.isInfinity && expected == actual;
+  }
+
+  /// Completes a pre-signature with the adaptor secret, giving an ordinary
+  /// BIP-340 signature.
+  static Uint8List adaptorComplete(List<int> presig, BigInt secret) {
+    final rPoint = Secp256k1.parseCompressed(presig.sublist(0, 33));
+    if (rPoint == null) throw ArgumentError('malformed pre-signature');
+    final sPrime = Secp256k1.bytesToBigInt(presig.sublist(33));
+    final s = Secp256k1.hasEvenY(rPoint)
+        ? (sPrime + secret) % Secp256k1.n
+        : (sPrime - secret) % Secp256k1.n;
+    return Uint8List.fromList(
+        [...Secp256k1.xOnly(rPoint), ...Secp256k1.scalarToBytes(s)]);
+  }
+
+  /// Recovers the adaptor secret from a pre-signature and the completed
+  /// signature. The caller checks that the result is the discrete log of the
+  /// adaptor point; a signature that was not completed from this
+  /// pre-signature gives garbage, not an error.
+  static BigInt adaptorExtract(List<int> presig, List<int> signature) {
+    final rPoint = Secp256k1.parseCompressed(presig.sublist(0, 33));
+    if (rPoint == null) throw ArgumentError('malformed pre-signature');
+    if (signature.length != 64) throw ArgumentError('malformed signature');
+    final sPrime = Secp256k1.bytesToBigInt(presig.sublist(33));
+    final s = Secp256k1.bytesToBigInt(signature.sublist(32));
+    return Secp256k1.hasEvenY(rPoint)
+        ? (s - sPrime) % Secp256k1.n
+        : (sPrime - s) % Secp256k1.n;
+  }
+
+  static BigInt _secret(List<int> secretKey) {
+    final d = Secp256k1.parseScalar(secretKey);
+    if (d == null) throw ArgumentError('secret key is not a canonical scalar');
+    return d;
+  }
+
+  static BigInt _nonce(BigInt d, List<int> pBytes, List<int> message, List<int> auxRand) {
+    final tBytes = Secp256k1.scalarToBytes(d);
+    final auxHash = taggedHash(_auxTag, auxRand);
+    final t = Uint8List(32);
+    for (var i = 0; i < 32; i++) {
+      t[i] = tBytes[i] ^ auxHash[i];
+    }
+    final rand = taggedHash(_nonceTag, [...t, ...pBytes, ...message]);
+    final k = Secp256k1.bytesToBigInt(rand) % Secp256k1.n;
+    if (k == BigInt.zero) throw StateError('zero nonce');
+    return k;
+  }
+
+  static BigInt _challenge(List<int> rBytes, List<int> pBytes, List<int> message) =>
+      Secp256k1.bytesToBigInt(taggedHash(_challengeTag, [...rBytes, ...pBytes, ...message])) %
+      Secp256k1.n;
+
+  static void _check32(List<int> value, String name) {
+    if (value.length != 32) throw ArgumentError('$name must be 32 bytes');
+  }
+}
