@@ -180,6 +180,96 @@ Future<PtlcInfo> _getById(Hash id) async {
 Future<int> _chainIdentifier() async =>
     (await znnClient.ledger.getFrontierMomentum()).chainIdentifier;
 
+/// The chain's clock: the frontier momentum's timestamp. The contract judges
+/// an expiry by the momentum it runs in, so this is the clock every check
+/// here reads, never the machine's.
+Future<int> _chainNow() async =>
+    (await znnClient.ledger.getFrontierMomentum()).timestamp;
+
+/// No unlock is sent with less than this left before the entry's expiry. The
+/// call takes two momentums to be answered, and one that lands after the
+/// expiry is refused with its witness already public: for a point lock that is
+/// the secret, which then opens the other leg of a swap for the counterparty
+/// while its own entry comes back to it at expiry.
+const _revealMargin = 60;
+
+String? _tooLateToReveal(PtlcInfo ptlc, int now) {
+  final left = ptlc.expirationTime - now;
+  if (left <= 0) return 'Cannot unlock ptlc. Time lock expired';
+  if (left < _revealMargin) {
+    return 'Only ${left}s left on the chain\'s clock, under the ${_revealMargin}s an '
+        'unlock needs. A call answered after the expiry is refused, and its witness '
+        'is public anyway. Not sending';
+  }
+  return null;
+}
+
+/// Whether the contract's receive block says it accepted the call: eight
+/// bytes of data, 1 for success.
+bool _accepted(List<int>? data) =>
+    data != null && data.length == 8 && Secp256k1.bytesToBigInt(data) == BigInt.one;
+
+AbiFunction? _ptlcFunction(List<int> data) {
+  for (var entry in Definitions.ptlc.entries) {
+    if (const ListEquality().equals(
+        AbiFunction.extractSignature(entry.encodeSignature()),
+        AbiFunction.extractSignature(data))) {
+      return AbiFunction(entry.name!, entry.inputs!);
+    }
+  }
+  return null;
+}
+
+/// Why 32 bytes are not an Ed25519 lock anyone should fund, or null. The
+/// contract checks only the length of an Ed25519 lock (zenon-ptlc GAPS G-17).
+/// Bytes that encode no point make an entry nothing opens, and a point of small
+/// order makes one anything opens: with the identity as the key, the signature
+/// 01 00..00 followed by 32 zero bytes verifies for every message.
+String? ed25519LockProblem(List<int> lock) {
+  final p = (BigInt.one << 255) - BigInt.from(19);
+  final bytes = List<int>.from(lock);
+  final sign = bytes[31] >> 7;
+  bytes[31] &= 0x7f;
+  var y = BigInt.zero;
+  for (var i = 31; i >= 0; i--) {
+    y = (y << 8) | BigInt.from(bytes[i]);
+  }
+  if (y >= p) return 'it is not a canonical Ed25519 point encoding';
+  final d = (BigInt.from(-121665) * BigInt.from(121666).modInverse(p)) % p;
+  final y2 = y * y % p;
+  final u = (y2 - BigInt.one) % p;
+  final v = (d * y2 + BigInt.one) % p;
+  var x = u * v.modPow(BigInt.from(3), p) % p *
+      (u * v.modPow(BigInt.from(7), p) % p).modPow((p - BigInt.from(5)) ~/ BigInt.from(8), p) %
+      p;
+  final vx2 = v * x % p * x % p;
+  if (vx2 == (p - u) % p) {
+    x = x * BigInt.two.modPow((p - BigInt.one) ~/ BigInt.from(4), p) % p;
+  } else if (vx2 != u) {
+    return 'it is not a point on Ed25519, so no signature would ever open it';
+  }
+  if (x == BigInt.zero && sign == 1) return 'it is not a canonical Ed25519 point encoding';
+  // 8·P, by three doublings (a = -1, dbl-2008-hwcd); the identity is (0 : Z : Z).
+  var X = x, Y = y, Z = BigInt.one;
+  for (var i = 0; i < 3; i++) {
+    final a = X * X % p;
+    final b = Y * Y % p;
+    final c = BigInt.two * Z * Z % p;
+    final dd = (p - a) % p;
+    final e = ((X + Y) * (X + Y) - a - b) % p;
+    final g = (dd + b) % p;
+    final f = (g - c) % p;
+    final h = (dd - b) % p;
+    X = e * f % p;
+    Y = g * h % p;
+    Z = f * g % p;
+  }
+  if (X == BigInt.zero && Y == Z) {
+    return 'it is a point of small order, for which signatures anyone can make verify';
+  }
+  return null;
+}
+
 /// Whether the entry's point lock is this wallet's own key, in which case the
