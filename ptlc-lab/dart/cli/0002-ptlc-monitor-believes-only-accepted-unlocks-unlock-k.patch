+Future<String?> _witnessProblem(PtlcInfo ptlc, Hash id, Address destination,
+    List<int> witness, int chain) async {
   switch (ptlc.pointType) {
     case PtlcPointType.ed25519:
-      final message = PtlcApi.unlockMessage(
-          await _chainIdentifier(), ptlc.pointType, id, destination);
-      if (!await Crypto.verify(witness, message, ptlc.pointLock)) {
-        print('${red('Error!')} the signature does not verify for this entry and destination');
-        return false;
+      final message = PtlcApi.unlockMessage(chain, ptlc.pointType, id, destination);
+      if (witness.length != 64 ||
+          !await Crypto.verify(witness, message, ptlc.pointLock)) {
+        return 'the signature does not verify for this entry and destination';
       }
-      return true;
+      return null;
     case PtlcPointType.bip340:
-      final message = PtlcApi.unlockMessage(
-          await _chainIdentifier(), ptlc.pointType, id, destination);
-      if (!Bip340.verify(ptlc.pointLock, message, witness)) {
-        print('${red('Error!')} the signature does not verify for this entry and destination');
-        return false;
+      final message = PtlcApi.unlockMessage(chain, ptlc.pointType, id, destination);
