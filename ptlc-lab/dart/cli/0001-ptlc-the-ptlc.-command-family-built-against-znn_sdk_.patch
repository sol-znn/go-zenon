+import 'dart:async';
+import 'dart:io';
+import 'dart:math';
+
+import 'package:collection/collection.dart';
+import 'package:convert/convert.dart';
+import 'package:dcli/dcli.dart' hide verbose;
+import 'package:znn_cli_dart/lib.dart';
+import 'package:znn_sdk_dart/znn_sdk_dart.dart';
+
+// The ptlc command family. The contract calls mirror htlc's; the key and
+// adaptor commands are what a swap needs around them. Nothing here talks to
+// a counterparty: the two parties of a swap run these commands in turn and
+// pass each other the values they print.
+
+void ptlcMenu() {
+  print('  ${white('PTLC')}');
+  print(
+      '    ptlc.create tokenStandard amount expirationTime (in hours) pointType pointLock [destination]');
+  print('    ptlc.unlock id [witness]');
+  print('    ptlc.proxyUnlock id destination witness');
+  print('    ptlc.reclaim id');
+  print('    ptlc.get id');
+  print('    ptlc.inspect blockHash');
+  print('    ptlc.monitor id');
+  print('    ptlc.message id destination pointType');
+  print('    ptlc.sign id destination secretKey [pointType]');
+  print('    ptlc.keygen');
+  print('    ptlc.point secret');
+  print('    ptlc.tweak point tweak');
+  print('    ptlc.tweakSecret secret tweak');
+  print('    ptlc.adaptorSign secretKey message adaptorPoint');
+  print('    ptlc.adaptorVerify publicKey message adaptorPoint preSignature');
+  print('    ptlc.adaptorComplete preSignature secret');
+  print('    ptlc.adaptorExtract preSignature signature');
+}
+
+Future<void> ptlcFunctions() async {
+  switch (args[0].split('.')[1]) {
+    case 'create':
+      verbose ? print('Description: Create a ptlc') : null;
+      await _create();
+      return;
+
+    case 'unlock':
+      verbose ? print('Description: Unlock an active ptlc to this address') : null;
+      await _unlock();
+      return;
+
+    case 'proxyUnlock':
+      verbose
+          ? print('Description: Unlock an active ptlc to another address')
+          : null;
+      await _proxyUnlock();
+      return;
+
+    case 'reclaim':
+      verbose ? print('Description: Reclaim an expired ptlc') : null;
+      await _reclaim();
+      return;
+
+    case 'get':
+      verbose ? print('Description: Display ptlc details') : null;
+      await _get();
+      return;
+
+    case 'inspect':
+      verbose ? print('Description: Inspect ptlc account-block') : null;
+      await _inspect();
+      return;
+
+    case 'monitor':
+      verbose
+          ? print(
+              'Description: Monitor ptlc by id -- automatically reclaim it or display its witness')
+          : null;
+      await _monitor();
+      return;
+
+    case 'message':
+      verbose ? print('Description: Print the unlock message a key must sign') : null;
+      await _message();
+      return;
+
+    case 'sign':
+      verbose ? print('Description: Sign the unlock message with a secret key') : null;
+      await _sign();
+      return;
+
+    case 'keygen':
+      verbose ? print('Description: Generate a secp256k1 secret and its points') : null;
+      _keygen();
+      return;
+
+    case 'point':
+      verbose ? print('Description: The point of a secret scalar') : null;
+      _point();
+      return;
+
+    case 'tweak':
+      verbose ? print('Description: Add a tweak to a point') : null;
+      _tweak();
+      return;
+
+    case 'tweakSecret':
+      verbose ? print('Description: Add a tweak to a secret scalar') : null;
+      _tweakSecret();
+      return;
+
+    case 'adaptorSign':
+      verbose ? print('Description: BIP-340 adaptor pre-signature') : null;
+      _adaptorSign();
+      return;
+
+    case 'adaptorVerify':
+      verbose ? print('Description: Verify a BIP-340 adaptor pre-signature') : null;
+      _adaptorVerify();
+      return;
+
+    case 'adaptorComplete':
+      verbose ? print('Description: Complete a pre-signature with the secret') : null;
+      _adaptorComplete();
+      return;
+
+    case 'adaptorExtract':
+      verbose ? print('Description: Extract the secret from a completed signature') : null;
+      _adaptorExtract();
+      return;
+
+    default:
+      invalidCommand();
+  }
+}
+
+// ---- helpers -------------------------------------------------------------
+
+List<int> _hex(String s, String what, [int? length]) {
+  final clean = s.startsWith('0x') ? s.substring(2) : s;
+  List<int> bytes;
+  try {
+    bytes = hex.decode(clean);
+  } catch (e) {
+    print('${red('Error!')} $what is not valid hex');
+    exit(-1);
+  }
+  if (length != null && bytes.length != length) {
+    print('${red('Error!')} $what must be $length bytes, got ${bytes.length}');
+    exit(-1);
+  }
+  return bytes;
+}
+
+BigInt _scalar(String s, String what) {
+  final t = Secp256k1.parseScalar(_hex(s, what, 32));
+  if (t == null) {
+    print('${red('Error!')} $what is not a canonical secp256k1 scalar');
+    exit(-1);
+  }
+  return t;
+}
+
+List<int> _randomBytes(int n) {
+  final r = Random.secure();
+  return List<int>.generate(n, (_) => r.nextInt(256));
+}
+
+String _h(List<int> b) => hex.encode(b);
+
+String _format(Duration d) => d.toString().split('.').first.padLeft(8, '0');
+
+Future<PtlcInfo> _getById(Hash id) async {
+  try {
+    return await znnClient.embedded.ptlc.getById(id);
+  } catch (e) {
+    print('${red('Error!')} The ptlc id $id does not exist');
+    exit(-1);
+  }
+}
+
+Future<int> _chainIdentifier() async =>
+    (await znnClient.ledger.getFrontierMomentum()).chainIdentifier;
+
+/// Whether the entry's point lock is this wallet's own key, in which case the
+/// wallet can produce the witness itself.
+Future<bool> _lockIsOurKey(PtlcInfo ptlc) async {
+  if (ptlc.pointType != PtlcPointType.ed25519) return false;
+  final ours = await znnClient.defaultKeyPair!.getPublicKey();
+  return const ListEquality().equals(ours, ptlc.pointLock);
+}
+
+// ---- contract calls ------------------------------------------------------
+
+Future<void> _create() async {
+  if (args.length < 6 || args.length > 7) {
+    print('Incorrect number of arguments. Expected:');
+    print(
+        'ptlc.create tokenStandard amount expirationTime (in hours) pointType pointLock [destination]');
+    print('Point types:');
+    print('  0: ED25519 key (32 bytes). Opened by a signature over the unlock message');
+    print('  1: BIP-340 key (32 bytes, x-only). Opened by a Schnorr signature over the unlock message');
+    print(
+        '  2: secp256k1 point (33 bytes, compressed). Opened by its scalar; destination is required');
+    return;
+  }
+
+  TokenStandard tokenStandard = getTokenStandard(args[1]);
+  Token token = await getToken(tokenStandard);
+  BigInt amount = AmountUtils.extractDecimals(args[2], token.decimals);
+  Function color = getColor(tokenStandard);
+
+  if (amount <= BigInt.zero) {
+    print('${red('Error!')} amount must be greater than 0');
+    return;
+  }
+  if (!await hasBalance(address, tokenStandard, amount)) {
+    return;
+  }
+
+  int expirationTime;
+  try {
+    expirationTime = int.parse(args[3]);
+  } catch (e) {
+    print('${red('Error!')} expirationTime must be an integer.');
+    return;
+  }
+  const minHours = 1;
+  const maxHours = 24 * 7;
+  if (expirationTime < minHours || expirationTime > maxHours) {
+    print(
+        '${red('Error!')} expirationTime (hours) must be at least $minHours and at most $maxHours.');
+    return;
+  }
+
+  int pointType;
+  try {
+    pointType = int.parse(args[4]);
+  } catch (e) {
+    print('${red('Error!')} point type must be an integer.');
+    return;
+  }
+  final lockSize = PtlcPointType.lockSizes[pointType];
+  if (lockSize == null) {
+    print('${red('Error!')} unknown point type $pointType');
+    return;
+  }
+  final pointLock = _hex(args[5], 'pointLock', lockSize);
+  if (pointType == PtlcPointType.secp256k1Point &&
+      Secp256k1.parseCompressed(pointLock) == null) {
+    print('${red('Error!')} pointLock is not a compressed secp256k1 point');
+    return;
+  }
+  if (pointType == PtlcPointType.bip340 && Secp256k1.liftX(pointLock) == null) {
+    print('${red('Error!')} pointLock is not a BIP-340 x-only key');
+    return;
+  }
+
+  Address destination = emptyAddress;
+  if (args.length == 7) {
+    destination = parseAddress(args[6]);
+    if (!assertUserAddress(destination)) {
+      return;
+    }
+  } else if (pointType == PtlcPointType.secp256k1Point) {
+    print(
+        '${red('Error!')} a point lock needs a destination: its scalar is a bearer secret');
+    return;
+  }
+
+  final duration = Duration(hours: expirationTime);
+  final frontier = await znnClient.ledger.getFrontierMomentum();
+  final expiresAt = frontier.timestamp + duration.inSeconds;
+
+  print(
+      'Creating ptlc with amount ${AmountUtils.addDecimals(amount, token.decimals)} ${color(token.symbol)}');
+  print('  Point type ${PtlcPointType.name(pointType)}, lock ${green(_h(pointLock))}');
+  print(destination == emptyAddress
+      ? '  Can be unlocked to any destination the witness names'
+      : '  Can be unlocked only to $destination');
+  print('  Can be reclaimed in ${_format(duration)} by $address');
+
+  AccountBlockTemplate block = await send(znnClient.embedded.ptlc
+      .create(token, amount, expiresAt, pointType, pointLock, destination));
+
+  print('Submitted ptlc with id ${green(block.hash.toString())}');
+  print('Done');
+}
+
+Future<void> _unlock() async {
+  if (args.length < 2 || args.length > 3) {
+    print('Incorrect number of arguments. Expected:');
+    print('ptlc.unlock id [witness]');
+    print(
+        'witness: the signature over the unlock message for a key type, the scalar for a point type.');
+    print('Omitted, the wallet signs with its own key when the lock is that key.');
+    return;
+  }
+
+  Hash id = parseHash(args[1]);
+  PtlcInfo ptlc = await _getById(id);
+  int now = DateTime.now().millisecondsSinceEpoch ~/ 1000;
+
+  if (ptlc.expirationTime <= now) {
+    print('${red('Error!')} Cannot unlock ptlc. Time lock expired');
+    return;
+  }
+  if (ptlc.hasFixedDestination && ptlc.destination != address) {
+    print(
+        '${red('Error!')} Cannot unlock ptlc to $address. It pays only ${ptlc.destination}');
+    return;
+  }
+
+  List<int> witness;
+  if (args.length == 3) {
+    witness = _hex(args[2], 'witness', PtlcPointType.witnessSizes[ptlc.pointType]);
+  } else if (await _lockIsOurKey(ptlc)) {
+    final message = PtlcApi.unlockMessage(
+        await _chainIdentifier(), ptlc.pointType, id, address);
+    witness = await znnClient.defaultKeyPair!.sign(message);
+    print('Signed the unlock message with this wallet\'s key');
+  } else {
+    print('${red('Error!')} the lock is not this wallet\'s key; a witness is needed');
+    return;
+  }
+
+  if (!await _checkWitness(ptlc, id, address, witness)) {
+    return;
+  }
+
+  Token token = await getToken(ptlc.tokenStandard);
+  Function color = getColor(ptlc.tokenStandard);
+  print(
+      'Unlocking ptlc id ${ptlc.id} with amount ${AmountUtils.addDecimals(ptlc.amount, token.decimals)} ${color(token.symbol)}');
+  await send(znnClient.embedded.ptlc.unlock(id, witness));
+  print('Done');
+  print(
+      'Use ${green('receiveAll')} to collect your ptlc amount after 2 momentums');
+}
+
+Future<void> _proxyUnlock() async {
+  if (args.length != 4) {
+    print('Incorrect number of arguments. Expected:');
+    print('ptlc.proxyUnlock id destination witness');
+    return;
+  }
+
+  Hash id = parseHash(args[1]);
+  Address destination = parseAddress(args[2]);
+  PtlcInfo ptlc = await _getById(id);
+  int now = DateTime.now().millisecondsSinceEpoch ~/ 1000;
+
+  if (ptlc.expirationTime <= now) {
+    print('${red('Error!')} Cannot unlock ptlc. Time lock expired');
+    return;
+  }
+  if (ptlc.hasFixedDestination && ptlc.destination != destination) {
+    print(
+        '${red('Error!')} Cannot unlock ptlc to $destination. It pays only ${ptlc.destination}');
+    return;
+  }
+  final witness = _hex(args[3], 'witness', PtlcPointType.witnessSizes[ptlc.pointType]);
+  if (!await _checkWitness(ptlc, id, destination, witness)) {
+    return;
+  }
+
+  Token token = await getToken(ptlc.tokenStandard);
+  Function color = getColor(ptlc.tokenStandard);
+  print(
+      'Unlocking ptlc id ${ptlc.id} with amount ${AmountUtils.addDecimals(ptlc.amount, token.decimals)} ${color(token.symbol)} to $destination');
+  await send(znnClient.embedded.ptlc.proxyUnlock(id, destination, witness));
+  print('Done');
+}
+
+/// Checks a witness locally before spending plasma on a call the contract
+/// would refuse.
+Future<bool> _checkWitness(
+    PtlcInfo ptlc, Hash id, Address destination, List<int> witness) async {
+  switch (ptlc.pointType) {
+    case PtlcPointType.ed25519:
+      final message = PtlcApi.unlockMessage(
+          await _chainIdentifier(), ptlc.pointType, id, destination);
+      if (!await Crypto.verify(witness, message, ptlc.pointLock)) {
+        print('${red('Error!')} the signature does not verify for this entry and destination');
+        return false;
+      }
+      return true;
+    case PtlcPointType.bip340:
+      final message = PtlcApi.unlockMessage(
+          await _chainIdentifier(), ptlc.pointType, id, destination);
+      if (!Bip340.verify(ptlc.pointLock, message, witness)) {
+        print('${red('Error!')} the signature does not verify for this entry and destination');
+        return false;
+      }
+      return true;
+    case PtlcPointType.secp256k1Point:
+      final t = Secp256k1.parseScalar(witness);
+      if (t == null ||
+          !const ListEquality().equals(Secp256k1.scalarToPoint(t), ptlc.pointLock)) {
+        print('${red('Error!')} the scalar is not the one behind this entry\'s point');
+        return false;
+      }
+      return true;
+    default:
+      print('${red('Error!')} unknown point type ${ptlc.pointType}');
+      return false;
+  }
+}
+
+Future<void> _reclaim() async {
+  if (args.length != 2) {
+    print('Incorrect number of arguments. Expected:');
+    print('ptlc.reclaim id');
+    return;
+  }
+
+  Hash id = parseHash(args[1]);
+  int now = DateTime.now().millisecondsSinceEpoch ~/ 1000;
+  PtlcInfo ptlc = await _getById(id);
+
+  if (ptlc.expirationTime > now) {
+    print(
+        '${red('Error!')} Cannot reclaim ptlc. Try again in ${_format(Duration(seconds: ptlc.expirationTime - now))}.');
+    return;
+  }
+  if (ptlc.timeLocked != address) {
+    print('${red('Error!')} Cannot reclaim ptlc. Permission denied');
+    return;
+  }
+
+  Token token = await getToken(ptlc.tokenStandard);
+  Function color = getColor(ptlc.tokenStandard);
+  print(
+      'Reclaiming ptlc id ${ptlc.id} with amount ${AmountUtils.addDecimals(ptlc.amount, token.decimals)} ${color(token.symbol)}');
+  await send(znnClient.embedded.ptlc.reclaim(id));
+  print('Done');
+  print(
+      'Use ${green('receiveAll')} to collect your ptlc amount after 2 momentums');
+}
+
+Future<void> _get() async {
+  if (args.length != 2) {
+    print('Incorrect number of arguments. Expected:');
+    print('ptlc.get id');
+    return;
+  }
+
+  Hash id = parseHash(args[1]);
+  PtlcInfo ptlc = await _getById(id);
+  _printInfo(ptlc);
+  print('Done');
+}
+
+void _printInfo(PtlcInfo ptlc) {
+  int now = DateTime.now().millisecondsSinceEpoch ~/ 1000;
+  print('Ptlc id ${ptlc.id} with amount ${ptlc.amount} ${ptlc.tokenStandard}');
+  print('   Point type ${PtlcPointType.name(ptlc.pointType)}, lock ${_h(ptlc.pointLock)}');
+  if (ptlc.expirationTime > now) {
+    print(ptlc.hasFixedDestination
+        ? '   Can be unlocked to ${ptlc.destination} with the point\'s witness'
+        : '   Can be unlocked to any destination the witness names');
+    print(
+        '   Can be reclaimed in ${_format(Duration(seconds: ptlc.expirationTime - now))} by ${ptlc.timeLocked}');
+  } else {
+    print('   Can be reclaimed now by ${ptlc.timeLocked}');
+  }
+}
+
+Future<void> _inspect() async {
+  if (args.length != 2) {
+    print('Incorrect number of arguments. Expected:');
+    print('ptlc.inspect blockHash');
+    return;
+  }
+
+  Hash blockHash = parseHash(args[1]);
+  var block = await znnClient.ledger.getAccountBlockByHash(blockHash);
+  if (block == null) {
+    print('The account block ${blockHash.toString()} does not exist');
+    return;
+  }
+  if (block.pairedAccountBlock == null ||
+      block.blockType != BlockTypeEnum.userSend.index) {
+    print('The account block was not sent by a user');
+    return;
+  }
+
+  Function eq = const ListEquality().equals;
+  AbiFunction? f;
+  for (var entry in Definitions.ptlc.entries) {
+    if (eq(AbiFunction.extractSignature(entry.encodeSignature()),
+        AbiFunction.extractSignature(block.data))) {
+      f = AbiFunction(entry.name!, entry.inputs!);
+    }
+  }
+  if (f == null) {
+    print('The account block contains invalid data');
+    return;
+  }
+
+  var txArgs = f.decode(block.data);
+  switch (f.name.toString()) {
+    case 'Unlock':
+      print(
+          'Unlock ptlc: id ${cyan(txArgs[0].toString())} unlocked by ${block.address} with witness: ${green(_h(txArgs[1]))}');
+      break;
+    case 'ProxyUnlock':
+      print(
+          'ProxyUnlock ptlc: id ${cyan(txArgs[0].toString())} unlocked by ${block.address} to ${txArgs[1]} with witness: ${green(_h(txArgs[2]))}');
+      break;
+    case 'Reclaim':
+      print(
+          'Reclaim ptlc: id ${red(txArgs[0].toString())} reclaimed by ${block.address}');
+      break;
+    case 'Create':
+      print('Create ptlc: ${AmountUtils.addDecimals(block.amount, block.token!.decimals)} '
+          '${block.token!.symbol} expiring ${txArgs[0]} '
+          'point type ${txArgs[1]} lock ${_h(txArgs[2])} '
+          'destination ${txArgs[3]} created by ${block.address}');
+      break;
+    default:
+      print('The account block contains an unknown function call');
+  }
+}
+
+/// Watches an entry: reclaims it for its creator once it expires, or prints
+/// the witness that opened it, which for a point lock is the swap secret.
+Future<void> _monitor() async {
+  if (args.length != 2) {
+    print('Incorrect number of arguments. Expected:');
+    print('ptlc.monitor id');
+    return;
+  }
+
+  Hash id = parseHash(args[1]);
+  PtlcInfo ptlc = await _getById(id);
+  _printInfo(ptlc);
+  print('Monitoring ptlc id ${ptlc.id}');
+
+  final contractHeight = (await znnClient.ledger.getFrontierAccountBlock(ptlcAddress))?.height ?? 0;
+  var lastHeight = contractHeight;
+
+  while (true) {
+    await Future.delayed(const Duration(seconds: 10));
+    final frontier = await znnClient.ledger.getFrontierMomentum();
+
+    // the entry is gone: find the block that took it
+    try {
+      await znnClient.embedded.ptlc.getById(id);
+    } catch (_) {
+      final head = (await znnClient.ledger.getFrontierAccountBlock(ptlcAddress))?.height ?? 0;
+      for (var h = lastHeight + 1; h <= head; h++) {
+        final blocks = await znnClient.ledger.getAccountBlocksByHeight(ptlcAddress, h, 1);
+        for (final b in blocks.list ?? []) {
+          final paired = b.pairedAccountBlock;
+          if (paired == null) continue;
+          AbiFunction? f;
+          for (var entry in Definitions.ptlc.entries) {
+            if (const ListEquality().equals(
+                AbiFunction.extractSignature(entry.encodeSignature()),
+                AbiFunction.extractSignature(paired.data))) {
+              f = AbiFunction(entry.name!, entry.inputs!);
+            }
+          }
+          if (f == null) continue;
+          final txArgs = f.decode(paired.data);
+          if (txArgs[0].toString() != id.toString()) continue;
+          if (f.name == 'Unlock') {
+            print('Ptlc was unlocked by ${paired.address}; witness ${green(_h(txArgs[1]))}');
+          } else if (f.name == 'ProxyUnlock') {
+            print(
+                'Ptlc was unlocked to ${txArgs[1]} by ${paired.address}; witness ${green(_h(txArgs[2]))}');
+          } else if (f.name == 'Reclaim') {
+            print('Ptlc was reclaimed by ${paired.address}');
+          }
+          print('Done');
+          return;
+        }
+      }
+      lastHeight = head;
+      print('Ptlc entry is gone; the block that took it was not found yet');
+      continue;
+    }
+
+    if (frontier.timestamp >= ptlc.expirationTime && ptlc.timeLocked == address) {
+      print('Ptlc expired; reclaiming');
+      await send(znnClient.embedded.ptlc.reclaim(id));
+      print('Done');
+      return;
+    }
+  }
+}
+
+// ---- messages and keys ---------------------------------------------------
+
+Future<void> _message() async {
+  if (args.length != 4) {
+    print('Incorrect number of arguments. Expected:');
+    print('ptlc.message id destination pointType');
+    return;
+  }
+  final id = parseHash(args[1]);
+  final destination = parseAddress(args[2]);
+  final pointType = int.parse(args[3]);
+  final chain = await _chainIdentifier();
+  print('Chain identifier: $chain');
+  print('Unlock message: ${green(_h(PtlcApi.unlockMessage(chain, pointType, id, destination)))}');
+}
+
+Future<void> _sign() async {
+  if (args.length < 4 || args.length > 5) {
+    print('Incorrect number of arguments. Expected:');
+    print('ptlc.sign id destination secretKey [pointType]');
+    print('pointType 0 signs with ED25519 (secretKey is the 32-byte seed), 1 with BIP-340 (default)');
+    return;
+  }
+  final id = parseHash(args[1]);
+  final destination = parseAddress(args[2]);
+  final secret = _hex(args[3], 'secretKey', 32);
+  final pointType = args.length == 5 ? int.parse(args[4]) : PtlcPointType.bip340;
+  final message = PtlcApi.unlockMessage(await _chainIdentifier(), pointType, id, destination);
+  List<int> signature;
+  List<int> publicKey;
+  if (pointType == PtlcPointType.ed25519) {
+    publicKey = await Crypto.getPublicKey(secret);
+    signature = await Crypto.sign(message, secret, publicKey);
+  } else if (pointType == PtlcPointType.bip340) {
+    publicKey = Bip340.publicKey(secret);
+    signature = Bip340.sign(secret, message, _randomBytes(32));
+  } else {
+    print('${red('Error!')} a point lock is opened by its scalar, not a signature');
+    return;
+  }
+  print('Point lock: ${_h(publicKey)}');
+  print('Witness: ${green(_h(signature))}');
+}
+
+void _keygen() {
+  final secret = _randomBytes(32);
+  final t = Secp256k1.parseScalar(secret);
+  if (t == null) {
+    _keygen();
+    return;
+  }
+  print('Secret: ${green(_h(secret))}');
+  print('Point (compressed, pointType 2): ${_h(Secp256k1.scalarToPoint(t))}');
+  print('Key (x-only, pointType 1): ${_h(Bip340.publicKey(secret))}');
+}
+
+void _point() {
+  if (args.length != 2) {
+    print('Incorrect number of arguments. Expected:');
+    print('ptlc.point secret');
+    return;
+  }
+  final t = _scalar(args[1], 'secret');
+  final secret = Secp256k1.scalarToBytes(t);
+  print('Point (compressed, pointType 2): ${_h(Secp256k1.scalarToPoint(t))}');
+  print('Key (x-only, pointType 1): ${_h(Bip340.publicKey(secret))}');
+}
+
+void _tweak() {
+  if (args.length != 3) {
+    print('Incorrect number of arguments. Expected:');
+    print('ptlc.tweak point tweak');
+    return;
+  }
+  final point = _hex(args[1], 'point', 33);
+  final d = _scalar(args[2], 'tweak');
+  print('Tweaked point: ${_h(Secp256k1.tweakPoint(point, d))}');
+}
+
+void _tweakSecret() {
+  if (args.length != 3) {
+    print('Incorrect number of arguments. Expected:');
+    print('ptlc.tweakSecret secret tweak');
+    return;
+  }
+  final t = _scalar(args[1], 'secret');
+  final d = _scalar(args[2], 'tweak');
+  final t2 = Secp256k1.tweakScalar(t, d);
+  print('Tweaked secret: ${green(_h(Secp256k1.scalarToBytes(t2)))}');
+  print('Its point: ${_h(Secp256k1.scalarToPoint(t2))}');
+}
+
+// ---- adaptor signatures --------------------------------------------------
+
+void _adaptorSign() {
+  if (args.length != 4) {
+    print('Incorrect number of arguments. Expected:');
+    print('ptlc.adaptorSign secretKey message adaptorPoint');
+    return;
+  }
+  final secret = _hex(args[1], 'secretKey', 32);
+  final message = _hex(args[2], 'message');
+  final adaptor = _hex(args[3], 'adaptorPoint', 33);
+  final presig = Bip340.adaptorSign(secret, message, adaptor, _randomBytes(32));
+  print('Public key: ${_h(Bip340.publicKey(secret))}');
+  print('Pre-signature: ${green(_h(presig))}');
+}
+
+void _adaptorVerify() {
+  if (args.length != 5) {
+    print('Incorrect number of arguments. Expected:');
+    print('ptlc.adaptorVerify publicKey message adaptorPoint preSignature');
+    return;
+  }
+  final ok = Bip340.adaptorVerify(_hex(args[1], 'publicKey', 32),
+      _hex(args[2], 'message'), _hex(args[3], 'adaptorPoint', 33), _hex(args[4], 'preSignature', 65));
+  print(ok ? green('valid') : red('invalid'));
+  if (!ok) exit(-1);
+}
+
+void _adaptorComplete() {
+  if (args.length != 3) {
+    print('Incorrect number of arguments. Expected:');
+    print('ptlc.adaptorComplete preSignature secret');
+    return;
+  }
+  final presig = _hex(args[1], 'preSignature', 65);
+  final t = _scalar(args[2], 'secret');
+  print('Signature: ${green(_h(Bip340.adaptorComplete(presig, t)))}');
+}
+
+void _adaptorExtract() {
+  if (args.length != 3) {
+    print('Incorrect number of arguments. Expected:');
+    print('ptlc.adaptorExtract preSignature signature');
+    return;
+  }
+  final presig = _hex(args[1], 'preSignature', 65);
+  final sig = _hex(args[2], 'signature', 64);
+  final t = Bip340.adaptorExtract(presig, sig);
+  print('Secret: ${green(_h(Secp256k1.scalarToBytes(t)))}');
+  print('Its point: ${_h(Secp256k1.scalarToPoint(t))}');
+}
