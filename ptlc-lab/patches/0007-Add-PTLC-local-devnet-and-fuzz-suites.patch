+	}
+
+	block := &nom.AccountBlock{
+		Version:              1,
+		ChainIdentifier:      momentum.ChainIdentifier,
+		BlockType:            blockType,
+		MomentumAcknowledged: momentum.Identifier(),
+		Address:              address,
+		Amount:               big.NewInt(0),
+		TokenStandard:        types.ZeroTokenStandard,
+		DescendantBlocks:     make([]*nom.AccountBlock, 0),
+	}
