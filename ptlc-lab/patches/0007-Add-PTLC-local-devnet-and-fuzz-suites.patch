+func (h *harness) eventually(timeout time.Duration, fn func() (bool, string)) {
+	h.t.Helper()
+
+	deadline := time.Now().Add(timeout)
+	var last string
+	for {
+		ok, msg := fn()
+		if ok {
+			return
+		}
+		if msg != "" {
+			last = msg
+		}
+		if time.Now().After(deadline) {
+			h.t.Fatalf("timed out after %s: %s", timeout, last)
+		}
+		time.Sleep(1 * time.Second)
+	}
+}
