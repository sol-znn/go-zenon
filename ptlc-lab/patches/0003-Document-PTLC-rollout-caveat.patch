Subject: [PATCH 03/11] Document PTLC rollout caveat

(cherry picked from commit 7635f8c756260d18c983aee8570b419149bbf095)
---
 docs/ptlc/README.md                     | 2 ++
 vm/embedded/embedded.go                 | 1 -
 vm/embedded/implementation/ptlc_test.go | 1 +
 3 files changed, 3 insertions(+), 1 deletion(-)

diff --git a/docs/ptlc/README.md b/docs/ptlc/README.md
index dec48d8..a41334d 100644
--- a/docs/ptlc/README.md
+++ b/docs/ptlc/README.md
@@ -50,6 +50,8 @@ HTLC unlocks prove knowledge of a preimage for a stored hash digest. PTLC unlock
 
 The PTLC contract is available only after `types.PtlcSpork` is enforced. The PTLC contract map includes the prior HTLC contract map, so existing embedded contracts remain available after PTLC activation.
 
+Operational rollout must activate sporks in chronological order. `PtlcSpork` assumes the prior HTLC and bridge/liquidity sporks have already been activated.
+
 ## Related docs
 
 - [Signing](SIGNING.md)
diff --git a/vm/embedded/embedded.go b/vm/embedded/embedded.go
index 082c67b..4569d29 100644
--- a/vm/embedded/embedded.go
+++ b/vm/embedded/embedded.go
@@ -110,7 +110,6 @@ func getBridgeAndLiquidity() map[types.Address]*embeddedImplementation {
 	contracts[types.LiquidityContract].m[cabi.EmergencyMethodName] = &implementation.EmergencyLiquidity{cabi.EmergencyMethodName}
 
 	return contracts
-
 }
 
 func getAccelerator() map[types.Address]*embeddedImplementation {
diff --git a/vm/embedded/implementation/ptlc_test.go b/vm/embedded/implementation/ptlc_test.go
index c22d12b..784acdd 100644
--- a/vm/embedded/implementation/ptlc_test.go
+++ b/vm/embedded/implementation/ptlc_test.go
@@ -96,6 +96,7 @@ func TestPtlc_VerifySignatureStableErrors(t *testing.T) {
 	}
 	message := definition.GetPtlcUnlockMessage(chainIdentifier, info.PointType, id, destination)
 
+	// All-0xff is outside the secp256k1 field/order ranges, so ParseSignature fails before verification.
 	common.ExpectError(t, verifyPtlcSignature(info, chainIdentifier, id, destination, bytes.Repeat([]byte{0xff}, 64)), constants.ErrInvalidPointSignature)
 
 	signature, err := schnorr.Sign(privateKey, message)
